# ──────────────────────────────────────────────────────────────────────────────
# MMI'e Cartes de visite — Configuration Docker / Production
# Copier ce fichier vers .env et renseigner les valeurs marquées CHANGE_ME
# Ne jamais committer .env dans Git
# ──────────────────────────────────────────────────────────────────────────────

APP_NAME="MMI'e Cartes de visite"
APP_ENV=production
APP_KEY=                          # CHANGE_ME — générer avec: php artisan key:generate
APP_DEBUG=false

# URL publique de production — détermine les URLs générées pour la carte, le QR et la vCard
APP_URL=https://carte.mmi-e.fr

APP_LOCALE=fr
APP_FALLBACK_LOCALE=fr
APP_FAKER_LOCALE=fr_FR

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=error

# ── Base de données MariaDB (Docker Compose) ───────────────────────────────────
# Ces valeurs doivent correspondre à celles du service "db" dans docker-compose.yml
DB_CONNECTION=mysql
DB_HOST=db                        # Nom du service Docker
DB_PORT=3306
DB_DATABASE=mmie_carte            # CHANGE_ME si différent
DB_USERNAME=mmie                  # CHANGE_ME
DB_PASSWORD=                      # CHANGE_ME — mot de passe fort requis

# ── Sessions / Cache ──────────────────────────────────────────────────────────
SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.mmi-e.fr         # Domaine parent pour les cookies

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local             # Photos stockées dans storage/app/private (volume Docker)
QUEUE_CONNECTION=database
CACHE_STORE=database

# ── Mail (non utilisé en MVP — prévu phase 2) ─────────────────────────────────
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noreply@mmi-e.fr"
MAIL_FROM_NAME="MMI'e"

# ── AWS S3 (non utilisé en MVP) ───────────────────────────────────────────────
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=eu-west-3
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="MMI'e"

# ── Apple Wallet (Phase 2) ────────────────────────────────────────────────────
# 1. Créer un Pass Type ID sur https://developer.apple.com → Identifiers → Pass Type IDs
# 2. Générer le certificat et l'exporter en .p12
# 3. Télécharger le WWDR depuis https://www.apple.com/certificateauthority/
# 4. Placer les fichiers dans storage/app/private/wallet/apple/ (hors Git)
APPLE_TEAM_ID=                                         # CHANGE_ME — ex: ABCD1234EF
APPLE_PASS_TYPE_IDENTIFIER=                            # CHANGE_ME — ex: pass.fr.mmi-e.carte-visite
APPLE_CERTIFICATE_PATH=/var/www/storage/app/private/wallet/apple/certificate.p12
APPLE_CERTIFICATE_PASSWORD=                            # CHANGE_ME
APPLE_WWDR_PATH=/var/www/storage/app/private/wallet/apple/wwdr.pem
APPLE_LOGO_PATH=/var/www/storage/app/private/wallet/apple/logo.png
APPLE_LOGO2X_PATH=/var/www/storage/app/private/wallet/apple/logo@2x.png
APPLE_ICON_PATH=/var/www/storage/app/private/wallet/apple/icon.png
APPLE_ICON2X_PATH=/var/www/storage/app/private/wallet/apple/icon@2x.png

# ── Google Wallet (Phase 2) ───────────────────────────────────────────────────
# 1. Créer un compte Issuer sur https://pay.google.com/business/console
# 2. Créer un projet Google Cloud + activer Google Wallet API
# 3. Créer un Service Account + télécharger le JSON de clé
# 4. Placer le JSON dans storage/app/private/wallet/google/ (hors Git)
# Note : départ en Demo Mode, publishing access à demander à Google
GOOGLE_WALLET_ISSUER_ID=                               # CHANGE_ME — ex: 3388000000022
GOOGLE_WALLET_CLASS_SUFFIX=mmie-carte-visite
GOOGLE_WALLET_SA_KEY_PATH=/var/www/storage/app/private/wallet/google/service-account.json
GOOGLE_WALLET_LOGO_URL=                                # CHANGE_ME — URL publique du logo MMI'e
